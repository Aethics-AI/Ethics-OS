{
  "$defs": {
    "DatasetInfo": {
      "description": "The dataset a task ran on, with a pinned revision for reproducibility.\n\n``revision`` is required. A dataset name alone does not identify data \u2014\nupstream can change it under you between runs.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "name",
        "revision"
      ],
      "title": "DatasetInfo",
      "type": "object"
    },
    "ModelInfo": {
      "description": "The model under evaluation.\n\n``params`` records the inference settings the run actually used, so a\nsampled run cannot later be mistaken for a deterministic one.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "id",
        "provider"
      ],
      "title": "ModelInfo",
      "type": "object"
    },
    "RunSummary": {
      "description": "Headline numbers across every task in a run.\n\n``mean_score`` is None rather than 0.0 when nothing was measured: a mean of\nno measurements is not a score, and reporting 0.0 would make a run that\nfailed to measure anything look like a run that measured a catastrophe.\n\n``underpowered_tasks`` names the tasks whose sample count fell below the\nthreshold in eval_config, so a consumer can see at the top level that a\nheadline number rests on too little data.",
      "properties": {
        "mean_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Score"
        },
        "tasks_measured": {
          "default": 0,
          "title": "Tasks Measured",
          "type": "integer"
        },
        "tasks_run": {
          "default": 0,
          "title": "Tasks Run",
          "type": "integer"
        },
        "underpowered_tasks": {
          "items": {
            "type": "string"
          },
          "title": "Underpowered Tasks",
          "type": "array"
        }
      },
      "title": "RunSummary",
      "type": "object"
    },
    "SampleScore": {
      "description": "One sample's contribution to a task's metric.\n\n``measured=False`` marks a sample the model never answered. ``value`` is\nstill a float either way, so filter on the flag rather than the number.",
      "properties": {
        "measured": {
          "default": true,
          "title": "Measured",
          "type": "boolean"
        },
        "response_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Digest"
        },
        "sample_id": {
          "title": "Sample Id",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "sample_id",
        "value"
      ],
      "title": "SampleScore",
      "type": "object"
    },
    "TaskResult": {
      "description": "One task's result within a run.\n\n``metric_value`` is None when the task was not measured \u2014 never a fabricated\ndefault (the honesty rule carried through from F1/F6). ``reliability`` and\n``method`` say how much to trust it.\n\nAn unmeasured task carries no value at all \u2014 the distinction a ``0.0``\nwould destroy.",
      "properties": {
        "dataset": {
          "$ref": "#/$defs/DatasetInfo"
        },
        "details": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Details"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "metric_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Value"
        },
        "passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Passed"
        },
        "reliability": {
          "title": "Reliability",
          "type": "string"
        },
        "sample_count": {
          "default": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "sample_scores": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/SampleScore"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Scores"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "task_version": {
          "title": "Task Version",
          "type": "string"
        },
        "uncertainty": {
          "$ref": "#/$defs/Uncertainty"
        }
      },
      "required": [
        "task_id",
        "task_version",
        "dataset",
        "metric",
        "method",
        "reliability"
      ],
      "title": "TaskResult",
      "type": "object"
    },
    "Uncertainty": {
      "description": "Statistical uncertainty around a metric value (VOS-5).\n\nA point estimate is not a claim: 0.61 from 30 samples and 0.61 from 3,000 are\ndifferent statements. Every field is optional \u2014 a statistic that cannot be\ncomputed is absent, never a fabricated 0.0 that would read as perfect\nprecision.\n\n``underpowered`` is a flag, not a filter \u2014 an underpowered result is still\nreported, just never silently weighted as though it were well-powered.",
      "properties": {
        "confidence_interval": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Interval"
        },
        "effect_size": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect Size"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "p_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P Value"
        },
        "sample_size": {
          "default": 0,
          "title": "Sample Size",
          "type": "integer"
        },
        "standard_error": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standard Error"
        },
        "underpowered": {
          "default": false,
          "title": "Underpowered",
          "type": "boolean"
        }
      },
      "title": "Uncertainty",
      "type": "object"
    }
  },
  "description": "A complete evaluation run \u2014 the top-level serialised contract.\n\nThis is what third-party tooling and the SaaS product read, so its shape is\na promise governed by SemVer (see docs/result-schema-compatibility.md).\n\nUnknown fields are ignored rather than rejected, which is what makes\nadditive (MINOR) changes safe for older readers.\n\n``aethics eval`` writes exactly this shape. It previously wrote a separate\nenvelope stamped ``schema_version 0.1.0``, so the published contract had no\nproducer a user could invoke and ``aethics validate`` checked the wrong\ndocument.",
  "properties": {
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "manifest": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manifest"
    },
    "manifest_fingerprint": {
      "title": "Manifest Fingerprint",
      "type": "string"
    },
    "model": {
      "$ref": "#/$defs/ModelInfo"
    },
    "provenance": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provenance"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/TaskResult"
      },
      "title": "Tasks",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "model",
    "manifest_fingerprint"
  ],
  "title": "RunResult",
  "type": "object"
}
